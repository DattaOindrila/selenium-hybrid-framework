<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  API tests only. Runs in well under a minute because it starts no browser.
      mvn clean test -Dsuite=api.xml
-->
<suite name="API Suite" verbose="1">

  <listeners>
    <listener class-name="com.qa.listeners.TestListener"/>
    <listener class-name="com.qa.listeners.RetryListener"/>
  </listeners>

  <test name="API">
    <packages>
      <package name="com.qa.tests.api"/>
    </packages>
  </test>

</suite>
