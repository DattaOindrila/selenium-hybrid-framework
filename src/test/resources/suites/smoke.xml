<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  The short suite: enough to prove the framework, the browser and the target site
  are all working, in well under a minute. Run this first after a clone.
      mvn clean test -Dsuite=smoke.xml
-->
<suite name="Smoke Suite" verbose="1">

  <listeners>
    <listener class-name="com.qa.listeners.TestListener"/>
    <listener class-name="com.qa.listeners.RetryListener"/>
  </listeners>

  <test name="Smoke">
    <groups>
      <run><include name="smoke"/></run>
    </groups>
    <packages>
      <package name="com.qa.tests.ui"/>
      <package name="com.qa.tests.api"/>
    </packages>
  </test>

</suite>
