{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/productsList and POST /api/searchProduct",
  "type": "object",
  "required": ["responseCode", "products"],
  "properties": {
    "responseCode": { "type": "integer" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "brand", "category"],
        "properties": {
          "id":    { "type": "integer", "minimum": 1 },
          "name":  { "type": "string", "minLength": 1 },
          "price": { "type": "string", "pattern": "^Rs\\. ?[0-9]+$" },
          "brand": { "type": "string", "minLength": 1 },
          "category": {
            "type": "object",
            "required": ["usertype", "category"],
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "usertype": {
                "type": "object",
                "required": ["usertype"],
                "properties": {
                  "usertype": { "type": "string", "enum": ["Women", "Men", "Kids"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
